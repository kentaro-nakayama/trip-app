# Neon Postgres — provisioned via `vercel integration add neon`, synced with
# `vercel env pull .env.local`. Do not set these by hand.
DATABASE_URL=

# Clerk — provisioned via `vercel integration add clerk`, synced with
# `vercel env pull .env.local`. Do not set these by hand.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Maps Platform — not available via Vercel Marketplace, so this must
# be created manually in Google Cloud Console:
#   1. https://console.cloud.google.com/google/maps-apis/credentials
#   2. Enable "Maps JavaScript API", "Places API (New)", and "Geocoding API"
#      (the geocoding one backs the "add spot by address" flow)
#   3. Create an API key, then restrict it to those APIs and to your site's
#      HTTP referrers (localhost:3000 for dev, your Vercel domain for prod)
#      since this key is exposed to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
